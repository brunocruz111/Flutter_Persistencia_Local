{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Flutter Web Persistent",
			"type": "shell",
			"command": "flutter",
			"args": [
				"run",
				"-d",
				"chrome",
				"--web-port",
				"5000",
				"--web-browser-flag=--user-data-dir=C:\\flutter_chrome_profile"
			],
			"isBackground": true,
			"problemMatcher": [
				"$flutter"
			],
			"group": "build"
		}
	]
}